{
  "schema": 1,
  "events": [
    {
      "id": "meet_alice",
      "instructions": [
        {
          "op": "branch",
          "flag": "alice.met",
          "if_set": [
            { "op": "set_flag", "flag": "alice.conversations", "value": true }
          ],
          "if_not_set": [
            { "op": "set_flag", "flag": "alice.met", "value": true }
          ]
        },
        { "op": "dialog", "speaker": "alice", "text_key": "alice.greeting.first" }
      ]
    },
    {
      "id": "alice_ask_help",
      "instructions": [
        {
          "op": "choice",
          "prompt_text_key": "alice.ask.help",
          "options": [
            {
              "text_key": "alice.opt.yes",
              "instructions": [
                { "op": "set_flag", "flag": "alice.quest.accepted", "value": true }
              ]
            },
            {
              "text_key": "alice.opt.no",
              "instructions": []
            }
          ]
        },
        { "op": "dialog", "speaker": "alice", "text_key": "alice.help.reply" }
      ]
    },
    {
      "id": "chest_west",
      "instructions": [
        { "op": "dialog", "speaker": "system", "text_key": "chest.opened" },
        { "op": "set_flag", "flag": "chest.west.opened", "value": true }
      ]
    },
    {
      "id": "alice_reward",
      "instructions": [
        { "op": "dialog", "speaker": "alice", "text_key": "alice.reward.line" }
      ]
    },
    {
      "id": "chest_west_echo",
      "instructions": [
        { "op": "dialog", "speaker": "system", "text_key": "chest.west.echo" }
      ]
    }
  ]
}